{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run typecheck)",
      "Bash(npm run build)",
      "Bash(npm run test:unit)",
      "Bash(npm run test:unit *)",
      "Bash(npm run versao)",
      "Bash(npm run test:rust)",
      "Bash(npm run tauri:mensagens)",
      "Bash(npm run web:build)",
      "Bash(cargo build)",
      "Bash(cargo fmt)",
      "Bash(cargo test)",
      "Bash(cargo test *)",
      "Bash(git status)",
      "Bash(git status *)",
      "Bash(git diff)",
      "Bash(git diff *)",
      "Bash(git log)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git branch)",
      "Bash(git branch -a)",
      "Bash(git branch -vv)",
      "Bash(git branch --show-current)",
      "Bash(git fetch)",
      "Bash(git fetch *)",
      "Bash(git grep *)",
      "Bash(gh run list)",
      "Bash(gh run list *)",
      "Bash(gh run view *)",
      "Bash(gh pr list)",
      "Bash(gh pr list *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh release list)",
      "Bash(gh release list *)",
      "Bash(gh release view *)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(git push * --force*)",
      "Bash(git push * -f*)",
      "Bash(git push --no-verify*)",
      "Bash(git push * --no-verify*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git reset --hard*)",
      "Bash(git clean *)",
      "Read(~/AppData/Roaming/Playtrove/**)",
      "Edit(~/AppData/Roaming/Playtrove/**)"
    ]
  }
}
