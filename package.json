{
  "name": "playtrove",
  "productName": "Playtrove",
  "version": "0.5.0",
  "description": "Your game library for Windows: emulators, achievements and playtime in one place.",
  "author": "LamarcKz",
  "homepage": "https://github.com/LamarcKz/Playtrove",
  "license": "MIT",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev --watch",
    "dev:nova-copia": "node scripts/dev-library.mjs",
    "build": "npm run typecheck && electron-vite build",
    "preview": "electron-vite preview",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:app",
    "test:unit": "vitest run",
    "test:app": "npm run build && playwright test",
    "versao": "node scripts/next-version.mjs",
    "dist": "npm run build && node scripts/dist.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "dependencies": {
    "better-sqlite3": "^13.0.3",
    "electron-updater": "^6.8.9"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/w3c-web-hid": "^1.0.7",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "electron": "^44.4.3",
    "electron-builder": "^26.15.3",
    "electron-vite": "^5.0.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "better-sqlite3": false,
    "electron-winstaller": false,
    "esbuild": false
  }
}
