{
  "name": "playtrove",
  "productName": "Playtrove",
  "version": "0.9.0",
  "description": "Your game library for Windows: emulators, achievements and playtime in one place.",
  "author": "LamarcKz",
  "homepage": "https://github.com/LamarcKz/Playtrove",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "tauri dev",
    "dev:nova-copia": "node scripts/dev-library.mjs",
    "build": "npm run typecheck && vite build",
    "typecheck": "tsc -b",
    "test": "npm run test:unit && npm run test:bridge && npm run test:rust && npm run test:app",
    "test:unit": "vitest run",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml",
    "test:bridge": "dotnet test bridge/PlaytroveBridge.Tests --nologo",
    "bridge:build": "node scripts/build-bridge.mjs",
    "test:app": "node scripts/build-test-app.mjs && playwright test",
    "versao": "node scripts/next-version.mjs",
    "dist": "npm run typecheck && node scripts/dist.mjs",
    "web:dev": "vite",
    "web:build": "vite build",
    "tauri:mensagens": "node scripts/backend-messages.mjs",
    "prepare": "git config core.hooksPath .githooks || exit 0"
  },
  "devDependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@playwright/test": "^1.63.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/api": "^2.12.4",
    "@tauri-apps/cli": "^2.12.4",
    "@types/node": "^24.13.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "class-variance-authority": "^0.7.1",
    "cn": "^0.3.0",
    "lucide-react": "^1.47.0",
    "radix-ui": "^1.6.7",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shadcn": "^4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "vite": "^7.3.6",
    "vitest": "^5.0.1"
  },
  "allowScripts": {
    "esbuild": false
  }
}
