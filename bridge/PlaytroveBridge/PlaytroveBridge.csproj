<Project Sdk="Microsoft.NET.Sdk">

  <!-- O plugin de biblioteca do Playnite que leva os jogos do Playtrove para o tema Aniki. -->
  <PropertyGroup>
    <TargetFramework>net462</TargetFramework>
    <LangVersion>latest</LangVersion>
    <AssemblyName>PlaytroveBridge</AssemblyName>
    <RootNamespace>PlaytroveBridge</RootNamespace>
    <Deterministic>true</Deterministic>
    <!-- Sem caminhos do computador de quem compilou dentro da dll. -->
    <PathMap>$(MSBuildProjectDirectory)=/build/bridge</PathMap>
    <DebugType>none</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- O Playnite já traz o SDK: ele não vai junto do plugin. -->
    <PackageReference Include="PlayniteSDK" Version="6.18.0" ExcludeAssets="runtime" />
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
    <Reference Include="System.Runtime.Serialization" />
    <Reference Include="System.Net.Http" />
    <!-- O aviso de erro do Playnite (ShowErrorMessage) usa os tipos do WPF. -->
    <Reference Include="PresentationFramework" />
    <Reference Include="PresentationCore" />
    <Reference Include="WindowsBase" />
  </ItemGroup>

  <ItemGroup>
    <None Include="extension.yaml" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
