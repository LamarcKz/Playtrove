{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Playtrove",
  "mainBinaryName": "Playtrove",
  "version": "../package.json",
  "identifier": "io.github.lamarckz.playtrove",
  "build": {
    "devUrl": "http://localhost:1420",
    "frontendDist": "../out/web",
    "beforeDevCommand": "npm run web:dev",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "createUpdaterArtifacts": true,
    "publisher": "LamarcKz",
    "copyright": "Copyright © 2026 LamarcKz",
    "homepage": "https://github.com/LamarcKz/Playtrove",
    "category": "Game",
    "shortDescription": "Your game library for Windows: emulators, achievements and playtime in one place.",
    "icon": ["../build/icon.ico"],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English", "PortugueseBR"],
        "installerIcon": "../build/icon.ico",
        "installerHooks": "windows/hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDYyQUQ4QUM3QUIyMDcyQjEKUldTeGNpQ3J4NHF0WWdJMzBIUDN3UkZybW9UdDliQUhlbGIvbGtVUzFUQ1k0eXE3WGYvb0MzRk8K",
      "endpoints": ["https://github.com/LamarcKz/Playtrove/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
