#!/bin/sh
# Trava: nada é enviado direto para a main; ela só muda por Pull Request da branch "desenvolvimento".
# Detalhes na seção "Git e GitHub" do CLAUDE.md e em "Histórico e versões" do ESTRUTURA.md.
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$remote_ref" = "refs/heads/main" ]; then
    echo ""
    echo "Envio bloqueado: a main (versão estável) só muda por Pull Request da branch desenvolvimento."
    echo ""
    exit 1
  fi
done
exit 0
